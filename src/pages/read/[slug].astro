---
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const issues = await getCollection('issues');

  return issues
    .filter((issue) => issue.data.published)
    .map((issue) => ({
      params: { slug: issue.id },
      props: { issue },
    }));
}

const { issue } = Astro.props;
---

<!DOCTYPE html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={issue.data.description} />
    <title>{issue.data.title}｜適界PLUS＋</title>

    <style>
      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        padding: 20px 14px 40px;
        background: #f3f3f3;
        color: #222;
        font-family: Arial, "Noto Sans TC", sans-serif;
      }

      main {
        width: 100%;
        max-width: 900px;
        margin: 0 auto;
      }

      .back-link {
        display: inline-block;
        margin-bottom: 18px;
        color: #555;
        text-decoration: none;
      }

      h1 {
        font-size: 26px;
        line-height: 1.5;
      }

      .description {
        line-height: 1.9;
        color: #555;
        white-space: pre-line;
      }

      #pdf-status {
        margin: 22px 0;
        padding: 14px;
        background: white;
        border-radius: 8px;
        text-align: center;
        line-height: 1.7;
      }

      #page-container {
        width: 100%;
        margin: 20px auto;
        padding: 10px;
        background: white;
        border-radius: 8px;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
        overflow: hidden;
      }

      #pdf-canvas {
        display: block;
        width: 100%;
        height: auto;
        margin: 0 auto;
        background: white;
      }

      .controls {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 14px;
        flex-wrap: wrap;
        margin: 22px auto 12px;
      }

      .controls button {
        min-width: 100px;
        padding: 12px 20px;
        border: 0;
        border-radius: 6px;
        background: #263b35;
        color: white;
        font-size: 16px;
        cursor: pointer;
      }

      .controls button:disabled {
        background: #aaa;
        cursor: not-allowed;
      }

      #page-number {
        color: #555;
        font-size: 15px;
        min-width: 100px;
        text-align: center;
      }

      .download-area {
        display: flex;
        justify-content: center;
        margin: 20px auto 28px;
      }

      .download-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 13px 24px;
        border-radius: 28px;
        background: #087fae;
        color: white;
        text-decoration: none;
        font-size: 16px;
        font-weight: 700;
      }

      .download-button:hover {
        background: #06658c;
      }

      .reading-hint {
        color: #666;
        text-align: center;
        font-size: 14px;
        line-height: 1.7;
      }

      @media (max-width: 600px) {
        body {
          padding: 14px 8px 30px;
        }

        h1 {
          font-size: 21px;
        }

        #page-container {
          padding: 4px;
          border-radius: 4px;
        }

        .controls {
          gap: 8px;
        }

        .controls button {
          min-width: 90px;
          padding: 12px 14px;
          font-size: 15px;
        }

        .download-button {
          width: 90%;
          max-width: 320px;
        }
      }
    </style>
  </head>

  <body>
    <main>
      <a class="back-link" href="/">← 返回期刊首頁</a>

      <h1>{issue.data.title}</h1>

      <p class="description">
        {issue.data.description}
      </p>

      <div id="pdf-status">
        PDF 載入中，請稍候……
      </div>

      <div id="page-container">
        <canvas id="pdf-canvas"></canvas>
      </div>

      <p class="reading-hint">
        使用下方按鈕切換頁面，手機可直接上下滑動頁面。
      </p>

      <div class="controls">
        <button id="prev-button" disabled>
          上一頁
        </button>

        <span id="page-number">
          準備中
        </span>

        <button id="next-button" disabled>
          下一頁
        </button>
      </div>

      <div class="download-area">
        <a
          class="download-button"
          href={issue.data.pdf_url}
          download
        >
          ↓ 下載 PDF
        </a>
      </div>
    </main>

    <div
      id="pdf-config"
      data-pdf-url={issue.data.pdf_url}
    ></div>

    <script>
      import * as pdfjsLib from 'pdfjs-dist';
      import pdfWorker from 'pdfjs-dist/build/pdf.worker.mjs?url';

      // 相容部分 Safari 版本
      if (!Map.prototype.getOrInsertComputed) {
        Map.prototype.getOrInsertComputed = function (key, callback) {
          if (!this.has(key)) {
            this.set(key, callback(key));
          }

          return this.get(key);
        };
      }

      if (!WeakMap.prototype.getOrInsertComputed) {
        WeakMap.prototype.getOrInsertComputed = function (key, callback) {
          if (!this.has(key)) {
            this.set(key, callback(key));
          }

          return this.get(key);
        };
      }

      pdfjsLib.GlobalWorkerOptions.workerSrc = pdfWorker;

      async function loadPDF() {
        const status = document.querySelector('#pdf-status');
        const canvas = document.querySelector('#pdf-canvas');
        const container = document.querySelector('#page-container');
        const pageNumber = document.querySelector('#page-number');
        const prevButton = document.querySelector('#prev-button');
        const nextButton = document.querySelector('#next-button');
        const pdfConfig = document.querySelector('#pdf-config');

        const pdfUrl = pdfConfig?.getAttribute('data-pdf-url');

        if (
          !status ||
          !canvas ||
          !container ||
          !pageNumber ||
          !prevButton ||
          !nextButton ||
          !pdfUrl
        ) {
          if (status) {
            status.textContent = '找不到 PDF 檔案網址。';
          }

          return;
        }

        const context = canvas.getContext('2d');

        if (!context) {
          status.textContent = '無法建立 PDF 閱讀畫面。';
          return;
        }

        let pdf;
        let currentPage = 1;
        let renderTask = null;
        let renderVersion = 0;

        function updateControls() {
          pageNumber.textContent =
            `第 ${currentPage} / ${pdf.numPages} 頁`;

          prevButton.disabled = currentPage <= 1;
          nextButton.disabled = currentPage >= pdf.numPages;
        }

        async function renderPage(pageNumberToRender) {
          const version = ++renderVersion;

          if (renderTask) {
            try {
              renderTask.cancel();
            } catch (_) {}

            renderTask = null;
          }

          status.textContent = '正在載入頁面……';

          try {
            const page = await pdf.getPage(pageNumberToRender);

            if (version !== renderVersion) return;

            const baseViewport = page.getViewport({
              scale: 1,
            });

            const availableWidth = Math.max(
              200,
              container.clientWidth - 8
            );

            const displayScale =
              availableWidth / baseViewport.width;

            const pixelRatio = Math.min(
              3,
              Math.max(1, window.devicePixelRatio || 1)
            );

            const viewport = page.getViewport({
              scale: displayScale * pixelRatio,
            });

            const displayViewport = page.getViewport({
              scale: displayScale,
            });

            canvas.width = Math.ceil(viewport.width);
            canvas.height = Math.ceil(viewport.height);

            canvas.style.width =
              `${displayViewport.width}px`;

            canvas.style.height =
              `${displayViewport.height}px`;

            context.setTransform(
              1,
              0,
              0,
              1,
              0,
              0
            );

            context.clearRect(
              0,
              0,
              canvas.width,
              canvas.height
            );

            renderTask = page.render({
              canvasContext: context,
              viewport,
            });

            await renderTask.promise;

            if (version !== renderVersion) return;

            renderTask = null;
            currentPage = pageNumberToRender;

            updateControls();

            status.textContent = '頁面載入完成。';
          } catch (error) {
            if (
              error?.name ===
              'RenderingCancelledException'
            ) {
              return;
            }

            console.error(
              'PDF 頁面顯示失敗：',
              error
            );

            if (version === renderVersion) {
              status.textContent =
                '頁面顯示失敗：' +
                (
                  error instanceof Error
                    ? error.message
                    : String(error)
                );
            }
          }
        }

        prevButton.addEventListener(
          'click',
          () => {
            if (currentPage > 1) {
              renderPage(currentPage - 1);
            }
          }
        );

        nextButton.addEventListener(
          'click',
          () => {
            if (currentPage < pdf.numPages) {
              renderPage(currentPage + 1);
            }
          }
        );

        try {
          status.textContent =
            '正在讀取 PDF，請稍候……';

          pdf = await pdfjsLib.getDocument({
            url: pdfUrl,
          }).promise;

          currentPage = 1;

          updateControls();

          await renderPage(currentPage);

          status.textContent =
            `PDF 載入完成，共 ${pdf.numPages} 頁。`;
        } catch (error) {
          console.error(
            'PDF 載入失敗：',
            error
          );

          status.textContent =
            'PDF 載入失敗：' +
            (
              error instanceof Error
                ? error.message
                : String(error)
            );
        }
      }

      loadPDF();
    </script>

    <!-- Cloudflare Web Analytics -->
    <script
      type="module"
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "4a9f3553ac1041ed8786972b3824e03b"}'
    ></script>
    <!-- End Cloudflare Web Analytics -->
  </body>
</html>
