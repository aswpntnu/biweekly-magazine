
---
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const issues = await getCollection('issues');

  return issues
    .filter((issue) => issue.data.published)
    .map((issue) => ({
      params: { slug: issue.id },
      props: { issue },
    }));
}

const { issue } = Astro.props;
---

<!DOCTYPE html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={issue.data.description} />
    <title>{issue.data.title}｜適界PLUS＋</title>

    <style>
      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        padding: 24px 16px 48px;
        background: #f3f3f3;
        color: #222;
        font-family: Arial, "Noto Sans TC", sans-serif;
      }

      main {
        max-width: 1200px;
        margin: 0 auto;
      }

      .back-link {
        display: inline-block;
        margin-bottom: 24px;
        color: #555;
        text-decoration: none;
      }

      h1 {
        font-size: 26px;
        line-height: 1.5;
      }

      .description {
        line-height: 1.9;
        color: #555;
        white-space: pre-line;
      }

      #pdf-status {
        margin: 28px 0;
        padding: 16px;
        background: white;
        border-radius: 8px;
        text-align: center;
      }

      #book-area {
        width: 100%;
        display: flex;
        justify-content: center;
        overflow: auto;
        margin: 24px auto;
        touch-action: none;
        -webkit-overflow-scrolling: touch;
      }

      #book {
        width: 100%;
        max-width: 1200px;
        margin: 0 auto;
        transform-origin: center top;
        flex-shrink: 0;
      }

      .zoom-hint {
        text-align: center;
        color: #666;
        font-size: 14px;
        margin: 12px 0;
      }

      .controls {
        display: flex;
        justify-content: center;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        margin: 20px auto;
      }

      .controls button {
        padding: 10px 22px;
        border: 0;
        border-radius: 6px;
        background: #263b35;
        color: white;
        font-size: 16px;
        cursor: pointer;
      }

      .controls button:disabled {
        background: #aaa;
        cursor: not-allowed;
      }

      #page-number {
        color: #555;
        font-size: 14px;
      }

      @media (max-width: 600px) {
        body {
          padding: 16px 10px 36px;
        }

        h1 {
          font-size: 21px;
        }

        .controls {
          gap: 8px;
        }

        .controls button {
          padding: 10px 14px;
          font-size: 14px;
        }
      }
    </style>
  </head>

  <body>
    <main>
      <a class="back-link" href="/">← 返回期刊首頁</a>

      <h1>{issue.data.title}</h1>
      <p class="description">{issue.data.description}</p>

      <div id="pdf-status">PDF 載入中，請稍候……</div>

      <div id="book-area">
        <div id="book"></div>
      </div>

      <p class="zoom-hint">
        手機閱讀：用兩根手指張開放大、靠近縮小
      </p>

      <div class="controls">
        <button id="prev-button" disabled>上一頁</button>
        <span id="page-number">準備中</span>
        <button id="next-button" disabled>下一頁</button>
      </div>
    </main>

    <div
      id="pdf-config"
      data-pdf-url={issue.data.pdf_url}
    ></div>

    <script>
      import * as pdfjsLib from 'pdfjs-dist';
      import pdfWorker from 'pdfjs-dist/build/pdf.worker.mjs?url';
      import { PageFlip } from 'page-flip';

      if (!Map.prototype.getOrInsertComputed) {
        Map.prototype.getOrInsertComputed = function (key, callback) {
          if (!this.has(key)) {
            this.set(key, callback(key));
          }
          return this.get(key);
        };
      }

      if (!WeakMap.prototype.getOrInsertComputed) {
        WeakMap.prototype.getOrInsertComputed = function (key, callback) {
          if (!this.has(key)) {
            this.set(key, callback(key));
          }
          return this.get(key);
        };
      }

      pdfjsLib.GlobalWorkerOptions.workerSrc = pdfWorker;

      async function loadPDF() {
        const status = document.querySelector('#pdf-status');
        const bookElement = document.querySelector('#book');
        const bookArea = document.querySelector('#book-area');
        const pageNumber = document.querySelector('#page-number');
        const prevButton = document.querySelector('#prev-button');
        const nextButton = document.querySelector('#next-button');
        const pdfConfig = document.querySelector('#pdf-config');

        const pdfUrl = pdfConfig?.getAttribute('data-pdf-url');

        if (
          !status ||
          !bookElement ||
          !bookArea ||
          !pageNumber ||
          !prevButton ||
          !nextButton ||
          !pdfUrl
        ) {
          if (status) {
            status.textContent = '找不到 PDF 檔案網址，請檢查期刊資料。';
          }
          return;
        }

        let pageFlip;

        try {
          status.textContent = '正在讀取 PDF，請稍候……';

          const pdf = await pdfjsLib.getDocument({
            url: pdfUrl,
          }).promise;

          const pageImages = [];
          let bookWidth = 600;
          let bookHeight = 850;

          for (
            let pageIndex = 1;
            pageIndex <= pdf.numPages;
            pageIndex++
          ) {
            status.textContent =
              `正在處理第 ${pageIndex} / ${pdf.numPages} 頁……`;

            const page = await pdf.getPage(pageIndex);
            const baseViewport = page.getViewport({ scale: 1 });

            if (pageIndex === 1) {
              bookWidth = 600;
              bookHeight = Math.round(
                600 * baseViewport.height / baseViewport.width
              );
            }

            const viewport = page.getViewport({ scale: 2.5 });
            const canvas = document.createElement('canvas');
            const context = canvas.getContext('2d');

            if (!context) {
              throw new Error('無法建立 PDF 頁面畫布。');
            }

            canvas.width = viewport.width;
            canvas.height = viewport.height;

            await page.render({
              canvas,
              canvasContext: context,
              viewport,
            }).promise;

            pageImages.push(canvas.toDataURL('image/jpeg', 0.95));

            canvas.width = 0;
            canvas.height = 0;
          }

          status.textContent = '正在建立翻頁閱讀器……';

          pageFlip = new PageFlip(bookElement, {
            width: bookWidth,
            height: bookHeight,
            size: 'stretch',
            minWidth: 280,
            maxWidth: 1200,
            minHeight: 396,
            maxHeight: 1700,
            drawShadow: true,
            flippingTime: 800,
            usePortrait: true,
            startPage: 0,
            autoSize: true,
            maxShadowOpacity: 0.5,
            showCover: true,
            mobileScrollSupport: false,
          });

          pageFlip.loadFromImages(pageImages);

          function updateControls() {
            const current = pageFlip.getCurrentPageIndex();
            const total = pageFlip.getPageCount();

            pageNumber.textContent =
              `第 ${current + 1} / ${total} 頁`;

            prevButton.disabled = current <= 0;
            nextButton.disabled = current >= total - 1;
          }

          pageFlip.on('flip', updateControls);

          prevButton.addEventListener('click', () => {
            pageFlip.flipPrev();
          });

          nextButton.addEventListener('click', () => {
            pageFlip.flipNext();
          });

          // 雙指縮放功能
          let zoomScale = 1;
          const minZoom = 1;
          const maxZoom = 3.5;
          const activePointers = new Map();
          let startDistance = 0;
          let startScale = 1;

          function getDistance(pointA, pointB) {
            const dx = pointA.x - pointB.x;
            const dy = pointA.y - pointB.y;

            return Math.sqrt(dx * dx + dy * dy);
          }

          function applyZoom() {
            bookElement.style.transform = `scale(${zoomScale})`;
          }

          bookArea.addEventListener('pointerdown', (event) => {
            activePointers.set(event.pointerId, {
              x: event.clientX,
              y: event.clientY,
            });

            if (activePointers.size === 2) {
              const points = Array.from(activePointers.values());

              startDistance = getDistance(points[0], points[1]);
              startScale = zoomScale;
            }
          });

          bookArea.addEventListener('pointermove', (event) => {
            if (!activePointers.has(event.pointerId)) {
              return;
            }

            activePointers.set(event.pointerId, {
              x: event.clientX,
              y: event.clientY,
            });

            if (activePointers.size === 2) {
              event.preventDefault();

              const points = Array.from(activePointers.values());
              const currentDistance = getDistance(points[0], points[1]);

              if (startDistance > 0) {
                zoomScale = Math.min(
                  maxZoom,
                  Math.max(
                    minZoom,
                    startScale * currentDistance / startDistance
                  )
                );

                applyZoom();
              }
            }
          });

          function endPointer(event) {
            activePointers.delete(event.pointerId);

            if (activePointers.size < 2) {
              startDistance = 0;
            }
          }

          bookArea.addEventListener('pointerup', endPointer);
          bookArea.addEventListener('pointercancel', endPointer);
          bookArea.addEventListener('pointerleave', endPointer);

          updateControls();

          status.textContent =
            `翻頁閱讀器載入成功！共 ${pdf.numPages} 頁。`;

        } catch (error) {
          console.error('閱讀器載入失敗：', error);

          status.textContent =
            '閱讀器載入失敗：' +
            (error instanceof Error ? error.message : String(error));
        }
      }

      loadPDF();
    </script>
  </body>
</html>

