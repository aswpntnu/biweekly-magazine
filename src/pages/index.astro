---
import '../styles/global.css';
import { getCollection } from 'astro:content';

const allIssues = await getCollection('issues');
const issues = allIssues
  .filter((issue) => issue.data.published)
  .sort((a, b) =>
    (b.data.publish_date || '').localeCompare(a.data.publish_date || '')
  );
---

<html lang="zh-Hant">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="適應運動，推廣適應體育與適應運動，促進不同能力者平等參與運動。" />
  <title>適應運動｜Adapted Sports+TW</title>

  <style>
    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      color: #173653;
      background: #fff;
      font-family: Arial, "Noto Sans TC", sans-serif;
    }

    .header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
      padding: 12px 6%;
      background: #fff;
      box-shadow: 0 2px 12px rgba(0,0,0,.06);
      position: sticky;
      top: 0;
      z-index: 20;
    }

    .brand img {
      display: block;
      width: 100px;
      height: 76px;
      object-fit: contain;
    }

    nav {
      display: flex;
      align-items: center;
      gap: 28px;
    }

    nav a {
      color: #173653;
      text-decoration: none;
      font-weight: 700;
      font-size: 16px;
    }

    nav a:hover {
      color: #079fc1;
    }

    nav .subscribe-link {
      padding: 11px 20px;
      border-radius: 24px;
      background: #087fae;
      color: white;
    }

    /* 首頁封面 */
    .hero {
      padding: 100px 24px 90px;
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      background: linear-gradient(135deg, #eaf8f8, #fff8e9);
    }

    .eyebrow,
    .section-label {
      color: #079fc1;
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 2px;
    }

    .hero h1 {
      width: 100%;
      max-width: 1000px;
      margin: 34px auto 26px;
      font-size: clamp(34px, 3.5vw, 48px);
      line-height: 1.5;
      letter-spacing: 0.03em;
      color: #123b60;
      font-weight: 800;
      text-align: center;
      text-wrap: balance;
    }

    .hero-description {
      width: 100%;
      max-width: 680px;
      margin: 0 auto 36px;
      font-size: 19px;
      line-height: 2;
      letter-spacing: 0.05em;
      color: #40566a;
      text-align: center;
      text-wrap: pretty;
    }

    .hero-button,
    .read-button {
      display: inline-block;
      padding: 14px 30px;
      border-radius: 30px;
      background: #087fae;
      color: white;
      text-decoration: none;
      font-weight: 700;
      font-size: 16px;
    }

    .hero-button:hover,
    .read-button:hover {
      background: #06658c;
    }

    .about,
    .issues {
      padding: 70px 7%;
      max-width: 1100px;
      margin: 0 auto;
    }

    .about h2,
    .issues h2 {
      font-size: 30px;
      color: #173653;
    }

    .about > p:last-child {
      max-width: 800px;
      line-height: 2;
      color: #555;
      font-size: 17px;
    }

    .issue-list {
      display: grid;
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .issue-card {
      display: grid;
      grid-template-columns: minmax(180px, 280px) 1fr;
      gap: 28px;
      padding: 24px;
      border: 1px solid #e8eeee;
      border-radius: 16px;
      background: #fff;
      box-shadow: 0 5px 20px rgba(0,0,0,.04);
    }

    .issue-card img {
      width: 100%;
      height: auto;
      object-fit: contain;
      border-radius: 8px;
    }

    .issue-info {
      align-self: center;
    }

    .issue-info h3 {
      line-height: 1.6;
    }

    .issue-info p {
      line-height: 1.8;
      color: #555;
    }

    .date {
      color: #078eaa !important;
      font-size: 14px;
    }

    footer {
      padding: 45px 24px;
      background: #173653;
      color: white;
      text-align: center;
      line-height: 1.9;
    }

    .social-links {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 24px;
      margin-bottom: 25px;
    }

    .social-links a {
      display: flex;
      justify-content: center;
      align-items: center;
      width: 48px;
      height: 48px;
      border-radius: 50%;
      background: white;
      color: #173653;
      text-decoration: none;
    }

    .social-links svg {
      width: 26px;
      height: 26px;
      fill: currentColor;
    }

    footer p {
      margin: 5px 0;
      font-size: 14px;
    }

    .footer-title {
      font-size: 18px;
      font-weight: 700;
      margin-bottom: 15px;
    }

    /* 手機版 */
    @media (max-width: 650px) {
      .header {
        flex-direction: column;
        gap: 8px;
        padding: 8px 12px 14px;
      }

      .brand img {
        width: 82px;
        height: 66px;
      }

      nav {
        width: 100%;
        justify-content: center;
        gap: 18px;
      }

      nav a {
        font-size: 14px;
      }

      nav .subscribe-link {
        padding: 9px 13px;
      }

      .hero {
        padding: 64px 20px 58px;
      }

      .hero h1 {
        max-width: 390px;
        margin: 22px auto 18px;
        font-size: clamp(25px, 7vw, 32px);
        line-height: 1.55;
        letter-spacing: 0.01em;
      }

      .hero-description {
        max-width: 340px;
        margin-bottom: 26px;
        font-size: 16px;
        line-height: 1.9;
        letter-spacing: 0.02em;
      }

      .about,
      .issues {
        padding: 48px 20px;
      }

      .issue-card {
        grid-template-columns: 1fr;
        gap: 18px;
        padding: 16px;
      }

      .issue-card img {
        max-width: 280px;
        margin: 0 auto;
      }

      .issue-info h3 {
        font-size: 19px;
      }

      footer {
        padding: 36px 18px;
      }
    }

    /* 小螢幕手機 */
    @media (max-width: 360px) {
      .hero {
        padding-left: 16px;
        padding-right: 16px;
      }

      .hero h1 {
        font-size: 25px;
      }

      nav {
        gap: 13px;
      }

      nav a {
        font-size: 13px;
      }
    }

    /* 電腦版：英文小標與閱讀按鈕強制置中 */
    @media (min-width: 651px) {
      .hero {
        display: flex !important;
        flex-direction: column !important;
        align-items: center !important;
      }

      .hero .eyebrow {
        display: block !important;
        width: 100% !important;
        text-align: center !important;
        margin-left: auto !important;
        margin-right: auto !important;
      }

      .hero .hero-button {
        display: block !important;
        width: fit-content !important;
        text-align: center !important;
        align-self: center !important;
        margin-left: auto !important;
        margin-right: auto !important;
      }
    }
  </style>
</head>

<body>
  <header class="header">
    <a href="/" class="brand" aria-label="適應運動首頁">
      <img
        src="/images/LINE_ALBUM_頭貼%20logo_261014_1.jpg"
        alt="適應運動 Adapted Sports+TW Logo"
      />
    </a>

    <nav>
      <a href="#issues">閱讀文章</a>
      <a href="#about">關於我們</a>
      <a
        class="subscribe-link"
        href="https://docs.google.com/forms/d/e/1FAIpQLSec3ZKzhrevKdy7iqmzs9kM1UzXrb1UZLRRWRbT2pW87iK2FQ/viewform?pli=1"
        target="_blank"
        rel="noopener noreferrer"
      >
        訂閱
      </a>
    </nav>
  </header>

  <main>
    <section class="hero">
      <p class="eyebrow">ADAPTED SPORTS · TAIWAN</p>

      <h1>
        讓運動不再受限，讓參與擁有更多可能。
      </h1>

      <p class="hero-description">
        從知識、研究到國際實踐，一起探索適應運動的多元世界。
      </p>

      <a class="hero-button" href="#issues">
        閱讀最新文章 ↓
      </a>
    </section>

    <section id="about" class="about">
      <p class="section-label">ABOUT US</p>

      <h2>關於適應運動</h2>

      <p>
        適應運動致力於推廣適應體育與適應運動相關概念，
        透過國內外研究、國際實務案例及專業知識介紹，
        促進不同能力者平等參與運動，
        讓每個人都能享有運動的權利與樂趣。
      </p>
    </section>

    <section id="issues" class="issues">
      <p class="section-label">OUR ARTICLES</p>

      <h2>閱讀文章</h2>

      {issues.length > 0 ? (
        <div class="issue-list">
          {issues.map((issue) => (
            <article class="issue-card">
              <img
                src={issue.data.cover || "/images/封面.jpg"}
                alt={`${issue.data.title}封面`}
              />

              <div class="issue-info">
                <p class="date">
                  {issue.data.publish_date || '出版日期待定'}
                  {issue.data.issue_number && ` · ${issue.data.issue_number}`}
                </p>

                <h3>{issue.data.title}</h3>

                <p>{issue.data.description}</p>

                {issue.data.pdf_url && (
                  <a
                    class="read-button"
                    href={`/read/${issue.id}`}
                  >
                    閱讀本期文章 ↗
                  </a>
                )}
              </div>
            </article>
          ))}
        </div>
      ) : (
        <p>新一期文章即將推出，敬請期待。</p>
      )}
    </section>
  </main>

  <footer>
    <div class="social-links">
      <a
        href="https://www.facebook.com/share/g/1DZJDZdJEf/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Facebook"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M13.5 21v-8.2h2.8l.4-3.2h-3.2V7.5c0-.9.3-1.6 1.6-1.6h1.7V3.1c-.3 0-1.3-.1-2.5-.1-2.5 0-4.2 1.5-4.2 4.3v2.3H7.3v3.2h2.8V21h3.4z"/>
        </svg>
      </a>

      <a
        href="https://www.instagram.com/aswp.ntnu/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Instagram"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5zm0 2a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V7a3 3 0 0 0-3-3H7zm5 3a5 5 0 1 1 0 10 5 5 0 0 1 0-10zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6zm5.5-3.5a1.2 1.2 0 1 1 0 2.4 1.2 1.2 0 0 1 0-2.4z"/>
        </svg>
      </a>
    </div>

    <p class="footer-title">適應運動 Adapted Sports+TW</p>

    <p>指導單位：運動部適應運動司</p>
    <p>執行計畫：115年至116年運動部適應運動國際專業培力計畫</p>
    <p>發行單位：國立臺灣師範大學體育研究與發展中心</p>
    <p>電話：(02)7749-3256</p>
    <p>電話：(02)7749-6990</p>
    <p>E-mail：aswp.ntnu@gmail.com</p>
    <p>地址：臺北市大安區和平東路一段162號</p>
  </footer>
<!-- Cloudflare Web Analytics -->
<script
  type="module"
  src="https://static.cloudflareinsights.com/beacon.min.js"
  data-cf-beacon='{"token": "4a9f3553ac1041ed8786972b3824e03b"}'
></script>
<!-- End Cloudflare Web Analytics -->
</body>
</html>
