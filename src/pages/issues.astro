---
import '../styles/global.css';
import { getCollection } from 'astro:content';

const allIssues = await getCollection('issues');

const issues = allIssues
  .filter((issue) => issue.data.published)
  .sort((a, b) =>
    (b.data.publish_date || '').localeCompare(a.data.publish_date || '')
  );
---

<html lang="zh-Hant">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta
    name="description"
    content="適界PLUS＋歷期期刊"
  />
  <title>歷期期刊｜適界PLUS＋</title>

  <style>
    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      color: #173653;
      background: #fff;
      font-family: Arial, "Noto Sans TC", sans-serif;
    }

    .header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
      padding: 12px 6%;
      background: #fff;
      box-shadow: 0 2px 12px rgba(0,0,0,.06);
      position: sticky;
      top: 0;
      z-index: 20;
    }

    .brand img {
      display: block;
      width: 100px;
      height: 76px;
      object-fit: contain;
    }

    nav {
      display: flex;
      align-items: center;
      gap: 28px;
    }

    nav a {
      color: #173653;
      text-decoration: none;
      font-weight: 700;
      font-size: 16px;
    }

    nav a:hover {
      color: #079fc1;
    }

    nav .subscribe-link {
      padding: 11px 20px;
      border-radius: 24px;
      background: #087fae;
      color: white;
    }

    main {
      max-width: 1150px;
      margin: 0 auto;
      padding: 70px 6%;
    }

    .back-link {
      display: inline-block;
      margin-bottom: 30px;
      color: #087fae;
      text-decoration: none;
      font-weight: 700;
    }

    .section-label {
      color: #079fc1;
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 2px;
    }

    h1 {
      margin: 12px 0 40px;
      font-size: 36px;
      color: #173653;
    }

    .issue-list {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 28px;
    }

    .issue-card {
      display: flex;
      flex-direction: column;
      padding: 18px;
      border: 1px solid #e8eeee;
      border-radius: 16px;
      background: #fff;
      box-shadow: 0 5px 20px rgba(0,0,0,.04);
      transition: transform .2s ease, box-shadow .2s ease;
    }

    .issue-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 10px 28px rgba(0,0,0,.08);
    }

    .issue-card img {
      width: 100%;
      aspect-ratio: 3 / 4;
      object-fit: contain;
      border-radius: 8px;
      background: #f7f7f7;
    }

    .date {
      color: #078eaa;
      font-size: 14px;
      margin: 18px 0 0;
    }

    h2 {
      font-size: 19px;
      line-height: 1.6;
      margin: 8px 0 10px;
    }

    .description {
      color: #555;
      line-height: 1.8;
      flex: 1;
    }

    .read-button {
      display: block;
      width: 100%;
      padding: 13px 20px;
      margin-top: 15px;
      border-radius: 28px;
      background: #087fae;
      color: white;
      text-align: center;
      text-decoration: none;
      font-weight: 700;
    }

    .read-button:hover {
      background: #06658c;
    }

    footer {
      padding: 45px 24px;
      background: #173653;
      color: white;
      text-align: center;
      line-height: 1.9;
    }

    footer p {
      margin: 5px 0;
      font-size: 14px;
    }

    .footer-title {
      font-size: 18px;
      font-weight: 700;
      margin-bottom: 15px;
    }

    .social-links {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 24px;
      margin-bottom: 25px;
    }

    .social-links a {
      display: flex;
      justify-content: center;
      align-items: center;
      width: 48px;
      height: 48px;
      border-radius: 50%;
      background: white;
      color: #173653;
      text-decoration: none;
    }

    .social-links svg {
      width: 26px;
      height: 26px;
      fill: currentColor;
    }

    @media (max-width: 900px) {
      .issue-list {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 650px) {
      .header {
        flex-direction: column;
        gap: 8px;
        padding: 8px 12px 14px;
      }

      .brand img {
        width: 82px;
        height: 66px;
      }

      nav {
        width: 100%;
        justify-content: center;
        gap: 18px;
      }

      nav a {
        font-size: 14px;
      }

      nav .subscribe-link {
        padding: 9px 13px;
      }

      main {
        padding: 48px 20px;
      }

      h1 {
        font-size: 29px;
        margin-bottom: 30px;
      }

      .issue-list {
        grid-template-columns: 1fr;
        gap: 22px;
      }

      .issue-card img {
        max-width: 320px;
        margin: 0 auto;
      }

      footer {
        padding: 36px 18px;
      }
    }
  </style>
</head>

<body>
  <header class="header">
    <a href="/" class="brand" aria-label="適應運動首頁">
      <img
        src="/images/LINE_ALBUM_頭貼%20logo_261014_1.jpg"
        alt="適應運動 Adapted Sports+TW Logo"
      />
    </a>

    <nav>
      <a href="/">首頁</a>
      <a href="/#about">關於我們</a>
      <a
        class="subscribe-link"
        href="https://docs.google.com/forms/d/e/1FAIpQLSec3ZKzhrevKdy7iqmzs9kM1UzXrb1UZLRRWRRBT2pW87iK2FQ/viewform?pli=1"
        target="_blank"
        rel="noopener noreferrer"
      >
        訂閱
      </a>
    </nav>
  </header>

  <main>
    <a class="back-link" href="/">← 回到首頁</a>

    <p class="section-label">ALL ISSUES</p>
    <h1>歷期期刊</h1>

    {issues.length > 0 ? (
      <div class="issue-list">
        {issues.map((issue) => (
          <article class="issue-card">
            <img
              src={issue.data.cover || "/images/封面.jpg"}
              alt={`${issue.data.title}封面`}
            />

            <p class="date">
              {issue.data.publish_date || '出版日期待定'}
              {issue.data.issue_number && ` · ${issue.data.issue_number}`}
            </p>

            <h2>{issue.data.title}</h2>

            <p class="description">
              {issue.data.description}
            </p>

            {issue.data.pdf_url && (
              <a
                class="read-button"
                href={`/read/${issue.id}`}
              >
                閱讀本期文章 ↗
              </a>
            )}
          </article>
        ))}
      </div>
    ) : (
      <p>目前還沒有已發布的期刊。</p>
    )}
  </main>

  <footer>
    <div class="social-links">
      <a
        href="https://www.facebook.com/share/g/1DZJDZdJEf/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Facebook"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M13.5 21v-8.2h2.8l.4-3.2h-3.2V7.5c0-.9.3-1.6 1.6-1.6h1.7V3.1c-.3 0-1.3-.1-2.5-.1-2.5 0-4.2 1.5-4.2 4.3v2.3H7.3v3.2h2.8V21h3.4z"/>
        </svg>
      </a>

      <a
        href="https://www.instagram.com/aswp.ntnu/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Instagram"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5zm0 2a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V7a3 3 0 0 0-3-3H7zm5 3a5 5 0 1 1 0 10 5 5 0 0 1 0-10zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6zm5.5-3.5a1.2 1.2 0 1 1 0 2.4 1.2 1.2 0 0 1 0-2.4z"/>
        </svg>
      </a>
    </div>

    <p class="footer-title">適應運動 Adapted Sports+TW</p>

    <p>指導單位：運動部適應運動司</p>
    <p>執行計畫：115年至116年運動部適應運動國際專業培力計畫</p>
    <p>發行單位：國立臺灣師範大學體育研究與發展中心</p>
    <p>電話：(02)7749-3256</p>
    <p>電話：(02)7749-6990</p>
    <p>E-mail：aswp.ntnu@gmail.com</p>
    <p>地址：臺北市大安區和平東路一段162號</p>
  </footer>

  <!-- Cloudflare Web Analytics -->
  <script
    type="module"
    src="https://static.cloudflareinsights.com/beacon.min.js"
    data-cf-beacon='{"token": "4a9f3553ac1041ed8786972b3824e03b"}'
  ></script>
  <!-- End Cloudflare Web Analytics -->
</body>
</html>
